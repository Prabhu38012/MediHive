# Copy this file to .env and fill in your values

# --- LLM Provider ---
# Choose one: "ollama" (local & free) or "groq" (cloud API & free tier)
LLM_PROVIDER=ollama

# --- Local Ollama Settings (100% Free & Local) ---
# Run Ollama locally: https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Groq Cloud Settings (100% Free ultra-fast cloud models) ---
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# --- App Settings ---
LLM_TEMPERATURE=0.1
DEBATE_DISAGREEMENT_THRESHOLD=0.5
SHARED_MEMORY_DB_PATH=./data/memory.db
