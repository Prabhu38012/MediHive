# Copy this file to .env and fill in your values

# --- LLM Provider ---
# Choose one: "groq", "openai", "ollama", or "grok"
LLM_PROVIDER=groq

# Groq Cloud settings (100% FREE ultra-fast models)
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=groq/compound-mini


# Grok / xAI settings (used if LLM_PROVIDER=grok)
# Get your API key from: https://console.x.ai
XAI_API_KEY=your_xai_api_key_here
GROK_MODEL=grok-2-latest

# OpenAI settings (used if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Ollama settings (used if LLM_PROVIDER=ollama)
# Run Ollama locally: https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- App settings ---
LLM_TEMPERATURE=0.1
DEBATE_DISAGREEMENT_THRESHOLD=0.5
SHARED_MEMORY_DB_PATH=./data/memory.db


